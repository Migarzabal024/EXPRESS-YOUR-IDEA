# better-sqlite3 13 trae SQLite ya compilado para Windows, macOS y Linux.
# Por un fallo de npm, cuando existe package-lock.json npm ignora eso e intenta
# compilarlo (en Windows exigiría Visual Studio). Sin lockfile instala bien,
# así que no lo usamos: las versiones de las dependencias están fijadas en
# cada package.json.
package-lock=false
