{
  "name": "express-your-idea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pizarra digital local-first para capturar, organizar y desarrollar ideas.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @eyi/desktop",
    "build": "npm run build -w @eyi/desktop",
    "dist:win": "npm run dist:win -w @eyi/desktop",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @eyi/storage-sqlite"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
